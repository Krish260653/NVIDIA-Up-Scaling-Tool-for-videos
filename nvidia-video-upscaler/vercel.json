{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://fax-rows-visual-pamela.trycloudflare.com/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://fax-rows-visual-pamela.trycloudflare.com/uploads/$1"
    },
    {
      "src": "/outputs/(.*)",
      "dest": "https://fax-rows-visual-pamela.trycloudflare.com/outputs/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
